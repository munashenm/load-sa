generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String
  role          String
  accountStatus String   @default("ACTIVE")
  verifiedBadge Boolean  @default(false)
  referralCode  String?  @unique
  referredByCode String?
  fraudFlagsJson String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  driverProfile      DriverProfile?
  businessAccounts   BusinessAccount[]
  ratingsGiven       BookingRating[]   @relation("RatingsGiven")
  safetyReports      SafetyReport[]
  bookingsAsCustomer Booking[]       @relation("CustomerBookings")
  businessMemberships BusinessMember[]
  sessions           Session[]
  supportTickets     SupportTicket[]
  disputesRaised     Dispute[]        @relation("DisputeRaisedBy")
  chatMessages       ChatMessage[]
  complaintsRaised   Complaint[]
  notifications      Notification[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model DriverProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationStatus String    @default("PENDING")
  idNumber           String?
  licenseNumber      String?
  province           String?
  city               String?
  bio                String?
  loadPreference     String    @default("ANY")
  isAvailable        Boolean   @default(false)
  accountStatus      String    @default("ACTIVE")
  reviewedAt         DateTime?
  reviewNotes        String?
  rating             Float     @default(5)
  bankAccountHolder  String?
  bankName           String?
  bankAccountNumber  String?
  bankBranchCode     String?
  idDocumentUrl      String?
  licenseDocumentUrl String?
  proofOfAddressUrl  String?
  vehicleRegistrationUrl String?
  vehiclePhotosJson  String?
  walletBalance      Float     @default(0)
  offersFreight      Boolean   @default(true)
  offersShuttle      Boolean   @default(false)
  pdpLicenceNumber   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  vehicles     Vehicle[]
  bookings     Booking[]           @relation("DriverBookings")
  payouts      Payout[]
  declines     BookingDecline[]
  withdrawals  WalletWithdrawal[]
}

model Vehicle {
  id              String        @id @default(cuid())
  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  type            String
  make            String?
  model           String?
  registration    String
  maxWeightKg     Int?
  maxVolumeM3     Float?
  hasTrailer      Boolean       @default(false)
  insuranceStatus String?
  createdAt       DateTime      @default(now())
}

model BookingDecline {
  id              String        @id @default(cuid())
  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  bookingId       String
  createdAt       DateTime      @default(now())

  @@unique([driverProfileId, bookingId])
}

/// Order / delivery request (customer-facing: "delivery")
model Booking {
  id         String         @id @default(cuid())
  reference  String         @unique
  customerId String
  customer   User           @relation("CustomerBookings", fields: [customerId], references: [id])
  businessAccountId String?
  businessAccount   BusinessAccount? @relation(fields: [businessAccountId], references: [id], onDelete: SetNull)
  driverId   String?
  driver     DriverProfile? @relation("DriverBookings", fields: [driverId], references: [id])
  status     String         @default("SEARCHING_DRIVER")
  serviceType String        @default("FREIGHT")

  pickupAddress   String
  pickupCity      String
  pickupProvince  String
  pickupLat       Float?
  pickupLng       Float?
  dropoffAddress  String
  dropoffCity     String
  dropoffProvince String
  dropoffLat      Float?
  dropoffLng      Float?

  vehicleType      String
  cargoDescription String?
  shuttleTripType     String?
  shuttleVehicleClass String?
  airportCode         String?
  flightNumber        String?
  passengerCount      Int      @default(1)
  luggagePieces       Int?
  hireHours           Float?
  passengerNotes      String?
  cargoSize        String?
  cargoDimensions  String?
  cargoImageUrl    String?
  weightKg         Int?
  urgency          String  @default("STANDARD")
  deliveryCategory String  @default("GENERAL")
  isFragile        Boolean @default(false)
  usesTollRoads    Boolean @default(false)
  isNightDelivery  Boolean @default(false)
  insuranceLevel   String  @default("STANDARD")
  stopsJson        String?
  priceBreakdownJson String?
  deliveryOtp      String?
  deliveryOtpVerifiedAt DateTime?
  estimatedPrice   Float
  finalPrice       Float?
  currency         String @default("ZAR")

  commissionPercent Float?
  platformFee       Float?
  driverEarnings    Float?

  paymentStatus String @default("UNPAID")

  driverLat        Float?
  driverLng        Float?
  lastLocationAt   DateTime?

  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payment Payment?
  proofs  DeliveryProof[]
  disputes Dispute[]
  chatMessages ChatMessage[]
  complaints   Complaint[]
  notifications Notification[]
  ratings      BookingRating[]
}

model Payment {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount    Float
  currency  String   @default("ZAR")
  status    String   @default("PENDING")
  provider  String   @default("PAYFAST")
  providerRef String?
  paidAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payout {
  id              String        @id @default(cuid())
  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  amount          Float
  currency        String        @default("ZAR")
  status          String        @default("PENDING")
  periodStart     DateTime?
  periodEnd       DateTime?
  paidAt          DateTime?
  reference       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model PlatformSettings {
  id                  String   @id @default("default")
  commissionPercent   Float    @default(15)
  baseFee             Float    @default(350)
  pricePerKm          Float    @default(12)
  sameDaySurchargePct Float    @default(25)
  expressSurchargePct Float    @default(45)
  fragileSurchargePct Float    @default(12)
  tollSurchargePct    Float    @default(8)
  nightSurchargePct   Float    @default(15)
  insuredSurchargePct Float    @default(18)
  multiStopSurchargePct Float  @default(20)
  vehicleRatesJson    String?
  updatedAt           DateTime @default(now()) @updatedAt
}

model DeliveryProof {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type        String   @default("PHOTO")
  notes       String?
  imageUrl    String?
  signatureUrl String?
  otpVerified Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model BookingRating {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User     @relation("RatingsGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  targetRole String
  scoresJson String
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([bookingId, fromUserId, targetRole])
}

model SafetyReport {
  id          String   @id @default(cuid())
  bookingId   String?
  reporterId  String
  reporter    User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  description String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
}

model BusinessAccount {
  id                 String   @id @default(cuid())
  name               String
  registrationNumber String?
  vatNumber          String?
  billingEmail       String
  billingPhone       String?
  billingAddress     String?
  billingCity        String?
  billingProvince    String?
  monthlyInvoicing   Boolean  @default(false)
  status             String   @default("ACTIVE")
  ownerUserId        String
  owner              User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  members   BusinessMember[]
  bookings  Booking[]
  invoices  BusinessInvoice[]
}

model BusinessMember {
  id                String          @id @default(cuid())
  businessAccountId String
  businessAccount   BusinessAccount @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  invitedEmail      String?
  role              String          @default("MEMBER")
  status            String          @default("ACTIVE")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([businessAccountId, userId])
  @@unique([businessAccountId, invitedEmail])
}

model BusinessInvoice {
  id                String          @id @default(cuid())
  businessAccountId String
  businessAccount   BusinessAccount @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  reference         String          @unique
  periodStart       DateTime
  periodEnd         DateTime
  totalAmount       Float
  currency          String          @default("ZAR")
  status            String          @default("DRAFT")
  lineItemsJson     String?
  issuedAt          DateTime?
  dueAt             DateTime?
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model WalletWithdrawal {
  id              String        @id @default(cuid())
  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  amount          Float
  status          String        @default("PENDING")
  createdAt       DateTime      @default(now())
}

model Dispute {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raisedById  String
  raisedBy    User     @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  reason      String
  status      String   @default("OPEN")
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

model Complaint {
  id              String   @id @default(cuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raisedById      String
  raisedBy        User     @relation(fields: [raisedById], references: [id], onDelete: Cascade)
  complainantType String
  subject         String
  description     String
  priority        String   @default("NORMAL")
  status          String   @default("OPEN")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
