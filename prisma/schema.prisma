generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String
  role          String
  accountStatus String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  driverProfile      DriverProfile?
  bookingsAsCustomer Booking[]       @relation("CustomerBookings")
  sessions           Session[]
  supportTickets     SupportTicket[]
  disputesRaised     Dispute[]        @relation("DisputeRaisedBy")
  chatMessages       ChatMessage[]
  complaintsRaised   Complaint[]
  notifications      Notification[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model DriverProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationStatus String    @default("PENDING")
  idNumber           String?
  licenseNumber      String?
  province           String?
  city               String?
  bio                String?
  loadPreference     String    @default("ANY")
  isAvailable        Boolean   @default(false)
  accountStatus      String    @default("ACTIVE")
  reviewedAt         DateTime?
  reviewNotes        String?
  rating             Float     @default(5)
  bankAccountHolder  String?
  bankName           String?
  bankAccountNumber  String?
  bankBranchCode     String?
  idDocumentUrl      String?
  licenseDocumentUrl String?
  proofOfAddressUrl  String?
  vehicleRegistrationUrl String?
  vehiclePhotosJson  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  vehicles  Vehicle[]
  bookings  Booking[]         @relation("DriverBookings")
  payouts   Payout[]
  declines  BookingDecline[]
}

model Vehicle {
  id              String        @id @default(cuid())
  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  type            String
  make            String?
  model           String?
  registration    String
  maxWeightKg     Int?
  maxVolumeM3     Float?
  hasTrailer      Boolean       @default(false)
  insuranceStatus String?
  createdAt       DateTime      @default(now())
}

model BookingDecline {
  id              String        @id @default(cuid())
  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  bookingId       String
  createdAt       DateTime      @default(now())

  @@unique([driverProfileId, bookingId])
}

/// Order / delivery request (customer-facing: "delivery")
model Booking {
  id         String         @id @default(cuid())
  reference  String         @unique
  customerId String
  customer   User           @relation("CustomerBookings", fields: [customerId], references: [id])
  driverId   String?
  driver     DriverProfile? @relation("DriverBookings", fields: [driverId], references: [id])
  status     String         @default("SEARCHING_DRIVER")

  pickupAddress   String
  pickupCity      String
  pickupProvince  String
  dropoffAddress  String
  dropoffCity     String
  dropoffProvince String

  vehicleType      String
  cargoDescription String
  cargoSize        String?
  cargoDimensions  String?
  cargoImageUrl    String?
  weightKg         Int?
  urgency          String  @default("STANDARD")
  estimatedPrice   Float
  finalPrice       Float?
  currency         String @default("ZAR")

  commissionPercent Float?
  platformFee       Float?
  driverEarnings    Float?

  paymentStatus String @default("UNPAID")

  driverLat        Float?
  driverLng        Float?
  lastLocationAt   DateTime?

  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payment Payment?
  proofs  DeliveryProof[]
  disputes Dispute[]
  chatMessages ChatMessage[]
  complaints   Complaint[]
  notifications Notification[]
}

model Payment {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount    Float
  currency  String   @default("ZAR")
  status    String   @default("PENDING")
  provider  String   @default("PAYFAST")
  providerRef String?
  paidAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payout {
  id              String        @id @default(cuid())
  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  amount          Float
  currency        String        @default("ZAR")
  status          String        @default("PENDING")
  periodStart     DateTime?
  periodEnd       DateTime?
  paidAt          DateTime?
  reference       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model PlatformSettings {
  id                  String   @id @default("default")
  commissionPercent   Float    @default(15)
  baseFee             Float    @default(350)
  pricePerKm          Float    @default(12)
  sameDaySurchargePct Float    @default(25)
  expressSurchargePct Float    @default(45)
  vehicleRatesJson    String?
  updatedAt           DateTime @default(now()) @updatedAt
}

model DeliveryProof {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type        String   @default("PHOTO")
  notes       String?
  imageUrl    String?
  createdAt   DateTime @default(now())
}

model Dispute {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raisedById  String
  raisedBy    User     @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  reason      String
  status      String   @default("OPEN")
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

model Complaint {
  id              String   @id @default(cuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raisedById      String
  raisedBy        User     @relation(fields: [raisedById], references: [id], onDelete: Cascade)
  complainantType String
  subject         String
  description     String
  priority        String   @default("NORMAL")
  status          String   @default("OPEN")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
