# Local PostgreSQL (example — use Docker or Railway Postgres)
# docker run --name fluxmove-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=fluxmove -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fluxmove"

# Required in production (Railway: add as a variable)
SESSION_SECRET="generate-with-openssl-rand-hex-32"

# Optional: run demo seed on first deploy (set to "true" once, then remove)
# RUN_SEED=true

# PayFast
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
NEXT_PUBLIC_APP_URL=https://fluxmove.co.za

# App store links (footer badges)
NEXT_PUBLIC_IOS_APP_URL=https://apps.apple.com/app/fluxmove
NEXT_PUBLIC_ANDROID_APP_URL=https://play.google.com/store/apps/details?id=za.fluxmove.driver

# Google Maps — autocomplete (browser) + route distance (server)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
GOOGLE_MAPS_API_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Twilio SMS / WhatsApp (optional — logs to console in dev when disabled)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+27XXXXXXXXX
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
SMS_ENABLED=false
WHATSAPP_ENABLED=false
