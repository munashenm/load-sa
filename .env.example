# Local PostgreSQL (example — use Docker or Railway Postgres)
# docker run --name loadsa-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=loadsa -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/loadsa"

# Required in production (Railway: add as a variable)
SESSION_SECRET="generate-with-openssl-rand-hex-32"

# Optional: run demo seed on first deploy (set to "true" once, then remove)
# RUN_SEED=true
